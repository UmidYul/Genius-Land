// Genius Land — схема БД.
// Этап 0: служебные таблицы (Setting, AuditLog).
// Этап 1: филиалы, пользователи, роли и права, сессии, коды, каналы связи, утверждения.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Служебное ───────────────────────────────────────────────────────────────

/// Настройка: бизнес-правила с цифрами живут здесь, а не в коде.
/// branchId = NULL — глобальное значение; иначе — значение для филиала (перекрывает глобальное).
/// Пара (key, branchId) уникальна, NULL считается равным NULL (см. миграцию: NULLS NOT DISTINCT).
model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @db.VarChar(120)
  value       Json
  branchId    String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([key, branchId])
  @@index([branchId])
}

/// Журнал действий: кто, что, над чем, было/стало, причина, когда, откуда.
/// Записи только добавляются — не меняются и не удаляются (триггер в БД).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// NULL — действие системы (фоновая задача, миграция) или неизвестного пользователя (неудачный вход).
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(80)
  branchId   String?  @db.Uuid
  before     Json?
  after      Json?
  reason     String?
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([branchId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// Счётчики ограничения частоты (вход, отправка кодов): фиксированное окно на ключ.
model RateLimitBucket {
  key       String   @id @db.VarChar(200)
  count     Int
  resetAt   DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([resetAt])
}

// ─── Организация ─────────────────────────────────────────────────────────────

/// Филиал школы. Название хранится на обоих языках интерфейса.
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  /// Короткий постоянный код (латиница), например `main`. Не показывается пользователям.
  code      String   @unique @db.VarChar(40)
  nameUz    String   @db.VarChar(120)
  nameRu    String   @db.VarChar(120)
  address   String?  @db.VarChar(300)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  assignmentBranches  RoleAssignmentBranch[]
  preferredBy         User[]                 @relation("PreferredBranch")
  settings            Setting[]
  auditLogs           AuditLog[]
  approvalRequests    ApprovalRequest[]
  academicYears       AcademicYear[]
  calendarDays        CalendarDay[]
  classes             Class[]
  staff               Staff[]
  students            Student[]
  teachingAssignments TeachingAssignment[]
  importJobs          ImportJob[]
}

// ─── Люди и доступ ───────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  /// Заблокирован суперадмином вручную — вход невозможен до разблокировки.
  BLOCKED
}

enum UserLocale {
  uz
  ru
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// +998XXXXXXXXX — логин сотрудника и номер для SMS.
  phone              String     @unique @db.VarChar(13)
  /// Хранится в нижнем регистре.
  email              String?    @unique @db.VarChar(254)
  fullName           String     @db.VarChar(160)
  /// Пароль — только у сотрудников. Родители и ученики входят по коду (бот/приложение).
  passwordHash       String?
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?  @db.Timestamptz(3)
  locale             UserLocale @default(uz)
  status             UserStatus @default(ACTIVE)
  /// Неудачные попытки входа подряд и временная блокировка (настройки auth.*).
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?  @db.Timestamptz(3)
  /// Выбор в переключателе филиала. NULL — «Все филиалы» (если доступно) или первый доступный.
  preferredBranchId  String?    @db.Uuid
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  deletedAt          DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  preferredBranch    Branch?               @relation("PreferredBranch", fields: [preferredBranchId], references: [id], onDelete: SetNull)
  roleAssignments    RoleAssignment[]      @relation("AssignmentUser")
  grantedAssignments RoleAssignment[]      @relation("AssignmentGrantedBy")
  sessions           Session[]
  trustedDevices     TrustedDevice[]
  otpCodes           OtpCode[]
  channels           NotificationChannel[]
  auditLogs          AuditLog[]            @relation("AuditActor")
  updatedSettings    Setting[]             @relation("SettingUpdatedBy")
  requestedApprovals ApprovalRequest[]     @relation("ApprovalRequestedBy")
  decidedApprovals   ApprovalRequest[]     @relation("ApprovalDecidedBy")
  staffProfiles      Staff[]
  studentProfile     Student?              @relation("StudentAccount")
  guardianLinks      GuardianLink[]
  studentHistory     StudentHistory[]
  importJobs         ImportJob[]

  @@index([status])
}

/// Право — код `модуль.ресурс.действие`. Список синхронизируется сидом из реестра в `@gl/core`.
model Permission {
  code      String   @id @db.VarChar(120)
  module    String   @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  roles RolePermission[]
}

enum PermissionScope {
  /// Технически всё (суперадмин).
  SYSTEM
  /// Все филиалы (основатель).
  ALL_BRANCHES
  /// Филиалы из назначения роли.
  BRANCH
  /// Классы/группы и предметы, которые ведёт учитель.
  ASSIGNED
  /// Класс, где пользователь — классный руководитель.
  HOMEROOM
  /// Только свои записи.
  SELF
  /// Только свои дети.
  CHILDREN
}

/// Роль. Названия — в словарях (`roles.<code>`), не в БД.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(40)
  /// Уровень для защиты от повышения привилегий: выдать можно только роль с rank ≤ своего.
  rank      Int
  isStaff   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  permissions RolePermission[]
  assignments RoleAssignment[]
}

model RolePermission {
  roleId         String          @db.Uuid
  permissionCode String          @db.VarChar(120)
  scope          PermissionScope

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
}

/// Пользователь ↔ роль ↔ набор филиалов (бухгалтер — один или оба; основатель — все по области).
model RoleAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  grantedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user      User                   @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User?                  @relation("AssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  branches  RoleAssignmentBranch[]

  @@unique([userId, roleId])
  @@index([roleId])
}

model RoleAssignmentBranch {
  assignmentId String @db.Uuid
  branchId     String @db.Uuid

  assignment RoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([assignmentId, branchId])
  @@index([branchId])
}

enum SessionKind {
  /// Браузер: токен в httpOnly cookie.
  WEB
  /// Приложение: refresh-токен; access-токен короткий и подписанный.
  API
}

/// Сессия. В БД — только хеш токена.
model Session {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  kind       SessionKind
  tokenHash  String      @unique @db.VarChar(64)
  ip         String?     @db.VarChar(45)
  userAgent  String?     @db.VarChar(400)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime    @db.Timestamptz(3)
  revokedAt  DateTime?   @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// Устройство, с которого уже был вход с кодом: со знакомого устройства код не спрашивается.
model TrustedDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @db.VarChar(64)
  userAgent  String?  @db.VarChar(400)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenHash])
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  CHANNEL_VERIFY
}

/// Одноразовый код. В БД — только HMAC кода; живёт `auth.codeTtlMinutes`, используется один раз.
model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String     @db.VarChar(64)
  /// Для CHANNEL_VERIFY — проверяемый адрес.
  target     String?    @db.VarChar(254)
  attempts   Int        @default(0)
  expiresAt  DateTime   @db.Timestamptz(3)
  consumedAt DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

enum ChannelType {
  SMS
  EMAIL
  TELEGRAM
}

/// Подключённый канал связи. Коды входа уходят во все включённые и подтверждённые каналы.
model NotificationChannel {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  type       ChannelType
  /// Телефон, e-mail или Telegram chat id.
  address    String      @db.VarChar(254)
  isEnabled  Boolean     @default(true)
  verifiedAt DateTime?   @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, address])
}

// ─── Утверждения ─────────────────────────────────────────────────────────────

/// Кто утверждает заявки данного типа. Типы появляются в модулях (финансы, журнал…).
model ApprovalPolicy {
  id               String   @id @default(uuid()) @db.Uuid
  /// Тип заявки, например `finance.payment.reverse`.
  type             String   @unique @db.VarChar(120)
  /// Код роли, которая утверждает: FOUNDER или DIRECTOR (своего филиала).
  approverRoleCode String   @db.VarChar(40)
  isActive         Boolean  @default(true)
  /// Дополнительные условия (пороги и т. п.) — читаются модулем, создающим заявку.
  conditions       Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id               String         @id @default(uuid()) @db.Uuid
  type             String         @db.VarChar(120)
  /// Филиал, к которому относится заявка; NULL — общешкольная.
  branchId         String?        @db.Uuid
  payload          Json
  status           ApprovalStatus @default(PENDING)
  approverRoleCode String         @db.VarChar(40)
  requestedById    String         @db.Uuid
  reason           String?
  decidedById      String?        @db.Uuid
  decidedAt        DateTime?      @db.Timestamptz(3)
  decisionComment  String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?   @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, approverRoleCode, branchId])
  @@index([requestedById])
}

// ─── Учебная структура (этап 2) ──────────────────────────────────────────────

/// Учебный год филиала. Создаётся сразу с четвертями. Текущий год у филиала один
/// (частичный уникальный индекс в миграции).
model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  /// Например «2026–2027».
  name      String   @db.VarChar(40)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  terms   Term[]
  classes Class[]

  @@unique([branchId, name])
}

/// Четверть. Каникулы — промежутки между четвертями.
model Term {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @db.Uuid
  /// 1–4
  number         Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, number])
}

enum CalendarDayKind {
  /// Праздник или выходной в обычно рабочий день.
  HOLIDAY
  /// Рабочий день в обычно выходной (перенос).
  WORKDAY
}

enum ClassType {
  /// 1–7 классы: учатся пн–пт.
  REGULAR
  /// Группы по направлениям 8–11: пн–сб (суббота до обеда).
  DIRECTION_GROUP
}

/// Исключение из обычной учебной недели. branchId = NULL — для обоих филиалов.
/// classType = NULL — для всех классов, иначе только для классов этого типа.
model CalendarDay {
  id        String          @id @default(uuid()) @db.Uuid
  branchId  String?         @db.Uuid
  date      DateTime        @db.Date
  kind      CalendarDayKind
  classType ClassType?
  note      String?         @db.VarChar(200)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, date, classType])
  @@index([date])
}

/// Предмет — общий справочник школы.
model Subject {
  id         String    @id @default(uuid()) @db.Uuid
  nameUz     String    @db.VarChar(120)
  nameRu     String    @db.VarChar(120)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  teachingAssignments TeachingAssignment[]

  @@unique([nameRu])
}

/// Направление групп 8–11 (Экономика, Медицина, Филология…) — редактируемый справочник.
model Direction {
  id         String    @id @default(uuid()) @db.Uuid
  nameUz     String    @db.VarChar(120)
  nameRu     String    @db.VarChar(120)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  classes Class[]

  @@unique([nameRu])
}

/// Единая учебная единица: класс 1–7 или группа по направлению 8–11.
model Class {
  id                String    @id @default(uuid()) @db.Uuid
  branchId          String    @db.Uuid
  academicYearId    String    @db.Uuid
  type              ClassType
  /// «5-А» или «ЭКОНОМИКА 1».
  name              String    @db.VarChar(60)
  /// Нормализованное название для уникальности (верхний регистр, без лишних пробелов).
  nameKey           String    @db.VarChar(60)
  /// 1–7 для REGULAR; NULL для групп (ученики в них — 8–11 класс).
  gradeLevel        Int?
  directionId       String?   @db.Uuid
  /// Задаётся явно; больше учеников не добавить.
  capacity          Int
  homeroomTeacherId String    @db.Uuid
  archivedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  direction           Direction?           @relation(fields: [directionId], references: [id], onDelete: Restrict)
  homeroomTeacher     Staff                @relation("Homeroom", fields: [homeroomTeacherId], references: [id], onDelete: Restrict)
  students            Student[]
  teachingAssignments TeachingAssignment[]

  @@unique([branchId, academicYearId, nameKey])
  @@index([branchId, academicYearId])
}

// ─── Люди (этап 2) ───────────────────────────────────────────────────────────

/// Сотрудник филиала. Связь с учётной записью — по userId (вход, области ASSIGNED/HOMEROOM).
model Staff {
  id         String    @id @default(uuid()) @db.Uuid
  branchId   String    @db.Uuid
  userId     String?   @db.Uuid
  fullName   String    @db.VarChar(160)
  phone      String    @db.VarChar(13)
  position   String    @db.VarChar(120)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  homeroomClasses     Class[]              @relation("Homeroom")
  teachingAssignments TeachingAssignment[]

  @@unique([branchId, phone])
  @@unique([branchId, userId])
  @@index([userId])
}

/// Учитель × класс × предмет.
model TeachingAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  /// Филиал класса (дублируется для фильтра по филиалу).
  branchId  String   @db.Uuid
  staffId   String   @db.Uuid
  classId   String   @db.Uuid
  subjectId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([classId, subjectId, staffId])
  @@index([staffId])
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  /// Выбыл из школы.
  LEFT
  /// Окончил школу.
  GRADUATED
  /// Переведён в другую школу или филиал.
  TRANSFERRED
}

/// Ученик. Номер GL-XXXXXX — сквозной по школе (последовательность в БД).
model Student {
  id                    String        @id @default(uuid()) @db.Uuid
  number                String        @unique @default(dbgenerated("('GL-'::text || lpad((nextval('student_number_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(12)
  branchId              String        @db.Uuid
  classId               String?       @db.Uuid
  /// Номер класса 1–11. Для групп 8–11 — только атрибут для отображения и отчётов.
  gradeLevel            Int
  lastName              String        @db.VarChar(80)
  firstName             String        @db.VarChar(80)
  middleName            String?       @db.VarChar(80)
  birthDate             DateTime      @db.Date
  gender                Gender
  status                StudentStatus @default(ACTIVE)
  emergencyContactName  String?       @db.VarChar(160)
  emergencyContactPhone String?       @db.VarChar(13)
  /// Учётная запись ученика (бот / приложение), если создана.
  userId                String?       @unique @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  branch    Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  class     Class?           @relation(fields: [classId], references: [id], onDelete: Restrict)
  user      User?            @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)
  guardians GuardianLink[]
  history   StudentHistory[]

  @@index([branchId, classId, status])
  @@index([lastName, firstName, birthDate])
}

enum GuardianRelation {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

/// Родитель/опекун (пользователь с ролью «Родитель») ↔ ученик.
model GuardianLink {
  id         String           @id @default(uuid()) @db.Uuid
  guardianId String           @db.Uuid
  studentId  String           @db.Uuid
  relation   GuardianRelation
  /// Главный контакт ученика — один на ученика (частичный уникальный индекс в миграции).
  isPrimary  Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  guardian User    @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([studentId])
}

enum StudentEventKind {
  ENROLLED
  TRANSFER
  STATUS
}

/// История ученика: зачисление, переводы между классами, смена статуса.
model StudentHistory {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @db.Uuid
  kind        StudentEventKind
  fromClassId String?          @db.Uuid
  toClassId   String?          @db.Uuid
  fromStatus  StudentStatus?
  toStatus    StudentStatus?
  /// Дата события в школьном календаре.
  date        DateTime         @db.Date
  reason      String?          @db.VarChar(500)
  actorId     String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
}

enum ImportKind {
  CLASSES
  STAFF
  STUDENTS
  GUARDIANS
}

enum ImportStatus {
  PREVIEW
  DONE
  CANCELLED
}

/// Импорт из Excel: разобранные строки ждут подтверждения, после — отчёт.
model ImportJob {
  id         String       @id @default(uuid()) @db.Uuid
  branchId   String       @db.Uuid
  kind       ImportKind
  actorId    String       @db.Uuid
  fileName   String       @db.VarChar(200)
  status     ImportStatus @default(PREVIEW)
  /// Строки файла с результатами проверки: [{ row, values, errors }].
  rows       Json
  report     Json?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?    @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([branchId, createdAt])
}

# Copy to .env (`cp .env.example .env`) and adjust. Never commit .env.
# Defaults match docker-compose.yml.

# --- Docker Compose (postgres) ---
POSTGRES_USER=genius
POSTGRES_PASSWORD=genius
POSTGRES_DB=genius_land
POSTGRES_PORT=5432

# --- Database ---
# Development database (web, worker, migrations, seed).
DATABASE_URL=postgresql://genius:genius@localhost:5432/genius_land?schema=public
# Separate database for integration tests — tests truncate tables.
DATABASE_URL_TEST=postgresql://genius:genius@localhost:5432/genius_land_test?schema=public

# --- Web ---
# Public base URL of the staff web app.
APP_URL=http://localhost:3000
PORT=3000

# --- Auth ---
# Secret for one-time code and API token signatures. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars

# --- Notifications (stage 1: console stand-ins) ---
# Optional: also append every outgoing SMS/e-mail as JSON lines to this file (dev, e2e tests).
DEV_OUTBOX_FILE=

# --- Worker ---
# Cron for the demo job (school time zone, Asia/Tashkent). Empty = do not schedule.
WORKER_DEMO_CRON=*/15 * * * *
# How long to wait for running jobs on shutdown, ms.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
